[wordpress-login]
enabled = true
filter = wordpress-login
action = iptables[name=HTTP, port=http, protocol=tcp]
         report_banip
logpath = /var/log/httpd/fail2ban_post_log
maxretry = 20
findtime = 120
bantime = 86400
usedns = no
backend = auto

[wordpress-spam]
enabled = true
filter = wordpress-spam
action = iptables[name=HTTP, port=http, protocol=tcp]
         report_banip
logpath = /var/log/httpd/fail2ban_post_log
maxretry = 2
findtime = 300
bantime = 86400
usedns = no
backend = auto

[wordpress-dos]
enabled = true
filter = wordpress-dos
action = iptables[name=HTTP, port=http, protocol=tcp]
         report_banip
logpath = /var/log/httpd/fail2ban_post_log
maxretry = 20
findtime = 120
bantime = 86400
usedns = no
backend = auto
