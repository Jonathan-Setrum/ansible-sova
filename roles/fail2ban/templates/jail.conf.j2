[http-get-dos]
enabled = false
port = http,https
filter = http-get-dos
logpath = /var/log/httpd/fail2ban_post_log
maxretry = 15
findtime = 60
bantime = 3600
action = iptables[name=HTTP, port=http, protocol=tcp]
usedns = no
backend = auto

[ssh]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/secure
maxretry = 15
findtime = 600
bantime = 86400
action = iptables[name=SSH, port=10022, protocol=tcp]
usedns = no
backend = auto

